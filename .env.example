# Application Environment
# development or production (defaults to production if unset)
APP_ENV=development

# PostgreSQL
# Local Docker: PG_HOST=db  |  SiteGround app: PG_HOST=localhost
PG_HOST=db
PG_PORT=5432
PG_DB=your_database
PG_USER=your_user
PG_PASSWORD=your_secure_password_here
PG_SSLMODE=prefer

# Discogs import (optional)
# DISCOGS_USERNAME=your_discogs_username
