# Application Environment
# development or production
APP_ENV=development

# PostgreSQL Connection
PG_HOST=localhost
PG_PORT=5432
PG_DB=api_db
PG_USER=api_user
PG_PASSWORD=your_secure_password_here
PG_SSLMODE=prefer

# For SiteGround production, set environment variables in:
# 1. SiteGround Site Tools → Devs → PHP Configuration
# 2. OR add to ~/.bashrc and source it
